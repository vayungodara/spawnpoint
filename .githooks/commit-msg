#!/bin/sh
# Commits in this repository carry no Amp thread links and never credit
# Claude or Anthropic (AGENTS.md, Delivery). .agents/setup installs this hook
# with `git config core.hooksPath .githooks`.
msg=$1
tmp=$msg.hook
export LC_ALL=C

# Check only the message: skip comments and everything below the scissors
# line that `git commit -v` adds above the diff.
if sed -n '/^# -* >8 -*$/q;/^#/d;p' "$msg" |
  grep -aEiq '^(co-authored-by:.*(claude|anthropic)|claude-session:)|generated with \[?claude code'; then
  echo 'commit-msg: remove the Claude or Anthropic credit from the message (see AGENTS.md)' >&2
  exit 1
fi

grep -aEiq '^amp-thread-id:' "$msg" || exit 0
grep -aEiv '^amp-thread-id:' "$msg" > "$tmp"
# grep exits 1 when nothing is left and 2 on an error; either way keep the
# original message and stop instead of committing a damaged one.
if [ $? -ne 0 ] || ! sed '/^#/d' "$tmp" | grep -aq '[^[:space:]]'; then
  rm -f "$tmp"
  echo 'commit-msg: could not drop the Amp-Thread-ID trailer, or the message is empty without it' >&2
  exit 1
fi
mv "$tmp" "$msg"
