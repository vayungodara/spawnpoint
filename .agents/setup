#!/usr/bin/env bash
set -euo pipefail

# Reproducible Linux integration prerequisites. Authentication and test worlds
# are deliberately not snapshotted; see AGENTS.md for the disposable fixture.
cd "$(dirname "$0")/.."
# Keeps Amp thread trailers and Claude credit out of commits (AGENTS.md).
git config core.hooksPath .githooks
packages=()
for pair in docker:docker.io xvfb-run:xvfb rsync:rsync zip:zip unzip:unzip; do
  command -v "${pair%%:*}" >/dev/null || packages+=("${pair#*:}")
done
if ((${#packages[@]})); then
  sudo apt-get update -qq
  sudo apt-get install -y "${packages[@]}" libgl1-mesa-dri libxrandr2 libxi6 libxcursor1 libxinerama1
fi
sudo mkdir -p /srv/sp
sudo chown "$(id -u):$(id -g)" /srv/sp
mkdir -p /srv/sp/Crafty/{servers,config,backups,logs,import} /srv/sp/{Tools,Shared,Backups,Spawnpoint/data}
if ! getent hosts spawnpoint.lan >/dev/null; then
  printf '127.0.0.1 spawnpoint.lan\n' | sudo tee -a /etc/hosts >/dev/null
fi
echo 'Installing locked npm dependencies and building the panel'
npm ci --no-audit --no-fund
npm run build
echo 'Ensuring the two test runtimes'
SPAWNPOINT_ROOT=/srv/sp node --input-type=module <<'JS'
import { ensureJdk } from './server/dist/services/temurin.js';
for (const feature of [25, 21]) if (!await ensureJdk(feature, console.log)) process.exit(1);
JS
launcher=/srv/sp/Tools/headlessmc/headlessmc-launcher-2.10.0.jar
mkdir -p "$(dirname "$launcher")"
if [[ ! -f "$launcher" ]]; then
  curl -fL --retry 2 https://github.com/headlesshq/headlessmc/releases/download/2.10.0/headlessmc-launcher-2.10.0.jar -o "$launcher.part"
  echo "52bd5006f478377b3893011d458562977d38c65ead6d2b31089beb4d614f13cd  $launcher.part" | sha256sum -c -
  mv "$launcher.part" "$launcher"
fi
echo 'Prerequisites ready; amp orb services ensure starts Crafty and the panel'
